<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>YTLoadster third-party Rust licenses</title>
  <style>
    body { color: #1f2328; font: 16px/1.5 system-ui, sans-serif; margin: 0 auto; max-width: 960px; padding: 32px; }
    h1, h2 { line-height: 1.25; }
    section { border-top: 1px solid #d0d7de; margin-top: 32px; padding-top: 16px; }
    pre { background: #f6f8fa; border-radius: 6px; overflow-x: auto; padding: 16px; white-space: pre-wrap; }
    code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
  </style>
</head>
<body>
  <h1>YTLoadster third-party Rust licenses</h1>
  <p>
    Generated from the locked dependency graph for the supported Windows x64,
    macOS Apple Silicon, and macOS Intel targets. Development-only dependencies
    are excluded.
  </p>
  {{#each licenses}}
  <section>
    <h2>{{name}} (<code>{{id}}</code>)</h2>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li>
        <code>{{crate.name}} {{crate.version}}</code>
        {{#if crate.repository}} — <a href="{{crate.repository}}">{{crate.repository}}</a>{{/if}}
      </li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
